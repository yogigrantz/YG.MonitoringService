{
  "YGLogging": {
    "folderName": "Log",
    "maxSize": 50000,
    "expiryDays": 3
  },
  "BGWorker": {
    "MonitorActionOptions": [
      {
        "Name": "Checking 0 sequencenbr",
        "RunIntervalInSeconds": 30,
        "ConnectionString": "server=;database=;user id=;password=;TrustServerCertificate=True;",
