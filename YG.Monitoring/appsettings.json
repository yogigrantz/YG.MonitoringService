        "EmailRecipients": [
          "yourname@mailinator.com",
          "yourbossname@mailinator.com"
        ],
        "EmailSubject": "Problem detected in MonitorTable",
        "ResilienceNbrOfRetries": 5,
        "ResilienceWaitInMs": 1000
      }
    ]
  },
  "YGSendEmail": {
    "Host": "yourSMTPHost",
    "Username": "yourusername",
    "Password": "yourpassword",
    "Port": 465,
    "SecureSocketOption": "Auto"
  },
  "DBConnTimeout": 60,
